# Core application
MONGODB_URI=mongodb://127.0.0.1:27017/ebm-entreprise
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial administrator account used by npm run seed
ADMIN_EMAIL=admin@ebm-entreprise.tn
ADMIN_PASSWORD=replace-with-a-strong-password

# Runtime uploads
UPLOAD_DIR=./uploads

# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Google Analytics
GA_MEASUREMENT_ID=
GA_DISABLED=false
GA_DEBUG=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_DISABLED=false
NEXT_PUBLIC_GA_DEBUG=false

# Optional Meta Pixel and Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_TEST_EVENT_CODE=
NEXT_PUBLIC_META_TRACKING_DISABLED=false
META_TRACKING_DISABLED=false
